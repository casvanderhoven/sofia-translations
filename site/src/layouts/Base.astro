---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "English translations of classical Greek and Latin texts, side by side with the original.",
} = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === "Sofia" ? "Sofia" : `${title} · Sofia`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;1,9..144,300&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Sans:wght@400;500&family=Gentium+Plus:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" lang="grc">Σοφία</a>
        <nav class="site-nav">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Texts</a>
          <a href="/about/" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Translations, notes and essays © Cas van der Hoven, licensed
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a>.
        Original texts from the <a href="https://www.perseus.tufts.edu/">Perseus Digital Library</a>, CC BY-SA 4.0.
      </div>
    </footer>
  </body>
</html>
